  "name_soft_patterns": ["鱼", "鲸"],
  "brand_words": [
    "大肥鱼", "肥鱼", "鲸鱼", "大肥鲸", "鲸鱼娘",
    "本鲸", "本鱼", "本肥鱼", "小鲛鱼"
